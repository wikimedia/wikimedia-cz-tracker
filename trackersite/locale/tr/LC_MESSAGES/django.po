msgid "Your password has been set. You may go ahead and log in now."
msgstr "Parolanız ayarlandı. Devam edip şimdi giriş yapabilirsiniz."

#: users/templates/users/password_reset_complete.html:12
msgid "Log in"
msgstr "Oturum aç"

