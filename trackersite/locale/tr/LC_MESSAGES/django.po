msgid "Password reset successful"
msgstr "Parola sıfırlama başarılı"

#: users/templates/users/password_reset_done.html:10
msgid "We've e-mailed you instructions for setting your password to the e-mail address you submitted. You should be receiving it shortly."
msgstr "Parolanızı gönderdiğiniz e-posta adresine ayarlamak için talimatları e-postayla gönderdik. Kısa sürede almalısınız."

#: users/templates/users/password_reset_email.html:2
#, python-format
msgid "You're receiving this e-mail because you requested a password reset for your user account at %(site_name)s."
msgstr "Bu e-postayı, adresindeki kullanıcı hesabınız %(site_name)s için bir parola sıfırlama istediğiniz için alıyorsunuz."

#: users/templates/users/password_reset_email.html:4
msgid "Please go to the following page and choose a new password:"
msgstr "Lütfen aşağıdaki sayfaya gidin ve yeni bir parola seçin:"

